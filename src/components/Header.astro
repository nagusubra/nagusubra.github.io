---
import ThemeToggle from "./ThemeToggle.astro";
import { site } from "../data/site";

const { pathname } = Astro.url;
const isWriting = pathname.startsWith("/writing");
const isPhotos = pathname.startsWith("/photos");
---

<header
  class="mx-auto flex max-w-2xl items-center justify-between px-6 pt-10 pb-6 sm:px-0"
>
  <a
    href="/"
    class="font-mono text-sm text-muted transition-colors hover:text-fg"
  >
    {site.name}
  </a>
  <nav class="flex items-center gap-5">
    <a
      href="/photos"
      class:list={[
        "text-sm transition-colors hover:text-fg",
        isPhotos ? "text-fg" : "text-muted",
      ]}
    >
      Photos
    </a>
    <a
      href="/writing"
      class:list={[
        "text-sm transition-colors hover:text-fg",
        isWriting ? "text-fg" : "text-muted",
      ]}
    >
      Writing
    </a>
    <ThemeToggle />
  </nav>
</header>