---
import { socials } from "../data/socials";

const year = new Date().getFullYear();
const iconAlternatives = socials.map((s, i) => ({
  ...s,
  id: i,
  title: s.label.replace(/^Writing on /, ""),
}));
---

<footer class="mx-auto max-w-2xl px-6 py-14 sm:px-0">
  <div class="flex flex-wrap items-center gap-x-6 gap-y-4 border-t border-border pt-6">
    {
      iconAlternatives.map((s) => (
        <a
          href={s.url}
          target="_blank"
          rel="noopener noreferrer"
          title={s.title}
          aria-label={s.label}
          class="group -m-1.5 inline-flex p-1.5 text-muted transition-colors hover:text-accent"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="h-5 w-5"
          >
            <path d={s.icon}></path>
          </svg>
        </a>
      ))
    }
  </div>
  <p class="mt-4 font-mono text-xs text-muted">
    &copy; {year} &middot; <a href="/rss.xml" class="hover:text-accent">RSS</a> &middot; <a href="https://nagusubra.github.io/traffic/" target="_blank" rel="noopener noreferrer" class="hover:text-accent">Traffic</a> &middot; <a href="https://foodsavr.ca" target="_blank" rel="noopener noreferrer" class="hover:text-accent">FoodSavr</a>
  </p>
</footer>