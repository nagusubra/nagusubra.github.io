---
import Base from "../layouts/Base.astro";
import { site } from "../data/site";
---

<Base title={`Not found  ${site.name}`} description="The page you requested couldn't be found.">
  <section class="py-20 text-center">
    <h1 class="text-4xl font-semibold mb-4">404 — Page not found</h1>
    <p class="text-muted mb-8 max-w-xl mx-auto">Looks like the page you're looking for doesn't exist, moved, or the link is broken. Here are some helpful places to continue:</p>

    <div class="flex justify-center gap-4 mb-8">
      <a class="btn" href="/">Home</a>
      <a class="btn btn-outline" href="/blog/">Blog</a>
      <a class="btn btn-ghost" href="/rss.xml">RSS</a>
    </div>

    <div class="prose mx-auto text-left max-w-prose">
      <h2>Quick tips</h2>
      <ul>
        <li>Check the URL for typos.</li>
        <li>If you followed an old link, try the <a href="/blog/">blog index</a> or the <a href="/">home page</a>.</li>
        <li>Still stuck? Open an issue on the repo so I can help: <a href="https://github.com/nagusubra/nagusubra.github.io/issues">Report an issue</a>.</li>
      </ul>
    </div>
  </section>
</Base>
