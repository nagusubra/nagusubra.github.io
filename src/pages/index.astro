---
import Base from "../layouts/Base.astro";
import { site } from "../data/site";
import { projects } from "../data/projects";
---

<Base>
  <section class="rise-in pt-6 pb-10">
    <h1 class="text-2xl font-semibold tracking-tight text-fg sm:text-3xl">
      {site.name}
    </h1>
    <p class="mt-3 max-w-lg text-lg text-muted">
      {site.tagline}
    </p>
    <p class="mt-6 max-w-lg leading-relaxed text-fg/90">
      {site.bio}
    </p>
  </section>

  <section class="rise-in border-t border-border py-10" style="animation-delay: 80ms;">
    <h2 class="mb-6 font-mono text-xs tracking-widest text-muted uppercase">
      Projects
    </h2>
    <ul class="flex flex-col gap-6">
      {
        projects.map((p) => (
          <li>
            <a
              href={p.url}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex flex-col gap-0.5"
            >
              <span class="font-medium text-fg transition-colors group-hover:text-accent">
                {p.name}
                <span class="ml-1 inline-block text-muted transition-transform group-hover:translate-x-0.5 group-hover:text-accent">
                  &rarr;
                </span>
              </span>
              <span class="text-sm text-muted">{p.description}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
