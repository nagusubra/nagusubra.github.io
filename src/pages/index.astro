---
import Base from "../layouts/Base.astro";
import { site } from "../data/site";
import { projects } from "../data/projects";
---

<Base>
  <section class="py-10">
    <h1
      class="reveal reveal-hero text-2xl font-semibold tracking-tight text-fg sm:text-3xl"
    >
      <span class="carousel-container" data-count="3">
        <span class="carousel-item">Subu</span>
        <span class="carousel-item">Subramanian</span>
        <span class="carousel-item">Subramanian Narayanan</span>
      </span>
    </h1>
    <p class="reveal mt-3 max-w-lg text-lg text-muted" style="animation-delay: 120ms">
      {site.tagline}
    </p>
    <p class="reveal mt-6 max-w-lg leading-relaxed text-fg/90" style="animation-delay: 260ms">
      {site.bio}
    </p>
  </section>

  <section class="reveal border-t border-border py-10" style="animation-delay: 420ms">
    <h2 class="mb-6 font-mono text-xs tracking-widest text-muted uppercase">
      Projects
    </h2>
    <ul class="flex flex-col gap-6">
      {
        projects.map((p, i) => (
          <li class="reveal" style={`animation-delay: ${520 + i * 90}ms`}>
            <a
              href={p.url}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex flex-col gap-0.5"
            >
              <span class="font-medium text-fg transition-colors group-hover:text-accent">
                {p.name}
                <span class="ml-1 inline-block text-muted transition-transform group-hover:translate-x-0.5 group-hover:text-accent">
                  &rarr;
                </span>
              </span>
              <span class="text-sm text-muted">{p.description}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
