---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { readingTimeMinutes } from "../../utils/readingTime";

const allPosts = await getCollection("writing", ({ data }) => !data.draft);
const posts = allPosts.sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);

const dateFmt = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
});
---

<Base
  title="Writing"
  description="Essays, notes, and takes -- on context engineering, building in the open, and whatever I can't stop thinking about."
>
  <section class="py-10">
    <h1 class="reveal reveal-hero mb-2 text-2xl font-semibold tracking-tight text-fg">
      Writing
    </h1>
    <p class="reveal mb-10 text-muted" style="animation-delay: 120ms">
      Essays, notes, and takes. New posts land here first, RSS second.
    </p>

    {
      posts.length === 0 ? (
        <p class="reveal rounded-lg border border-dashed border-border px-5 py-8 text-sm text-muted" style="animation-delay: 240ms">
          Nothing published yet -- first post is on its way. Check back
          soon, or grab the{" "}
          <a href="/rss.xml" class="text-accent underline">
            RSS feed
          </a>{" "}
          to be the first to know.
        </p>
      ) : (
        <ul class="flex flex-col gap-7">
          {posts.map((post, i) => (
            <li class="reveal" style={`animation-delay: ${240 + i * 80}ms`}>
              <a href={`/writing/${post.id}/`} class="group block">
                <div class="flex items-baseline justify-between gap-4">
                  <span class="font-medium text-fg transition-colors group-hover:text-accent">
                    {post.data.title}
                  </span>
                  <span class="shrink-0 font-mono text-xs text-muted">
                    {readingTimeMinutes(post.body)} min &middot; {dateFmt.format(post.data.publishDate)}
                  </span>
                </div>
                <p class="mt-1 text-sm text-muted">{post.data.description}</p>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</Base>
