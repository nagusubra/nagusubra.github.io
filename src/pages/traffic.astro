---
import Base from "../layouts/Base.astro";
---

<Base title="Traffic Dashboard">
  <section class="pt-6 pb-10">
    <h1 class="text-2xl font-semibold tracking-tight text-fg sm:text-3xl">
      Traffic Dashboard
    </h1>
    <p class="mt-3 max-w-lg text-lg text-muted">
      Public stats for my repositories. For detailed traffic data (views, clones, referrers), see
      <a href="https://github.com/nagusubra?tab=repositories" target="_blank" rel="noopener noreferrer" class="hover:text-accent">GitHub Insights</a>.
    </p>
  </section>

  <section class="border-t border-border py-10">
    <h2 class="mb-6 font-mono text-xs tracking-widest text-muted uppercase">
      Repository Stats
    </h2>
    <div id="repos-grid" class="flex flex-col gap-6">
      <p class="text-muted text-sm">Loading repository data...</p>
    </div>
  </section>

  <script is:inline>
    const REPOS = [
      "nagusubra/timeseries-qc",
      "nagusubra/duvals_triangle_plotter",
      "nagusubra/AI-customer-counter",
      "nagusubra/databricks_hackathon_2024",
      "nagusubra/model_training_resource_consumption_benchmark",
    ];

    async function fetchRepo(owner, name) {
      const res = await fetch(`https://api.github.com/repos/${owner}/${name}`);
      if (!res.ok) return null;
      return res.json();
    }

    async function loadRepos() {
      const grid = document.getElementById("repos-grid");
      const results = await Promise.all(
        REPOS.map((r) => {
          const [owner, name] = r.split("/");
          return fetchRepo(owner, name);
        })
      );

      const valid = results.filter(Boolean);
      if (valid.length === 0) {
        grid.innerHTML = '<p class="text-muted text-sm">Failed to load repository data.</p>';
        return;
      }

      grid.innerHTML = valid
        .map(
          (r) => `
        <a href="${r.html_url}" target="_blank" rel="noopener noreferrer"
           class="group flex flex-col gap-2 rounded-lg border border-border p-4 transition-colors hover:border-accent">
          <div class="flex items-center justify-between">
            <span class="font-medium text-fg transition-colors group-hover:text-accent">
              ${r.name}
              <span class="ml-1 inline-block text-muted transition-transform group-hover:translate-x-0.5 group-hover:text-accent">&rarr;</span>
            </span>
            <span class="text-xs text-muted">${r.language || "N/A"}</span>
          </div>
          <p class="text-sm text-muted">${r.description || "No description"}</p>
          <div class="flex gap-4 text-xs text-muted">
            <span>&#9733; ${r.stargazers_count}</span>
            <span>&#9860; ${r.forks_count}</span>
            <span>&#128065; ${r.watchers_count}</span>
            <span>${r.open_issues_count} issues</span>
          </div>
        </a>
      `
        )
        .join("");
    }

    loadRepos();
  </script>
</Base>
